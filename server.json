{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.mayarid/mayar",
  "title": "Mayar",
  "description": "Mayar payments (Indonesia): invoices, payment links, products, customers, transactions and QRIS.",
  "repository": {
    "url": "https://github.com/mayarid/mayar-agent-plugin",
    "source": "github"
  },
  "websiteUrl": "https://mayar.id",
  "icons": [
    {
      "src": "https://framerusercontent.com/images/bbv2nhY3LkxyXJP6QGzHIHGHw.png",
      "mimeType": "image/png",
      "sizes": [
        "1024x1024"
      ]
    }
  ],
  "version": "1.0.0",
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.mayar.id/mcp",
      "headers": [
        {
          "name": "Authorization",
          "description": "Mayar production API key from https://web.mayar.id/api-keys (the Bearer prefix is optional)",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ]
}
